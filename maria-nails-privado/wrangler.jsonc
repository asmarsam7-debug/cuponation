{
  "name": "maria-nails-privado",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://privado.themarianails.com",
    "ENABLED": "true",
    "MAIL_FROM": "Acceso privado <contacto@themarianails.com>",
    "OWNER_EMAIL": "zelqoza@gmail.com",
    "RECEIPT_COPY_EMAIL": "liralitmex@gmail.com",
    "PRIVACY_EMAIL": "zelqoza@gmail.com",
    "PRIVACY_ADDRESS": "Av. Hacienda del Rosario 209-A, El Rosario, 37125 León de los Aldama, Gto."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maria-nails-accesos",
      "database_id": "7cf49200-521a-4c88-b162-c0cd6bd0a31a"
    }
  ],
  "routes": [
    {
      "pattern": "privado.themarianails.com",
      "custom_domain": true
    },
    {
      "pattern": "privado.liralit.com",
      "custom_domain": true
    }
  ]
}
