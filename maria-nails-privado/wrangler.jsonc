{
  "name": "maria-nails-privado",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "vars": {"PUBLIC_ORIGIN":"https://themarianails.com","ENABLED":"false"},
  "d1_databases": [{"binding":"DB","database_name":"maria-nails-accesos","database_id":"CONFIGURAR_ANTES_DE_DESPLEGAR"}],
  "r2_buckets": [{"binding":"PRIVATE","bucket_name":"maria-nails-propuesta-privada"}]
}
